# Frontend Environment Variables
# Note: In Vite, only variables prefixed with VITE_ are exposed to client code

# Backend API URL (optional - defaults to /api proxy)
# If not set, the vite.config.ts proxy will handle API requests
# Set this if you want to point to a different backend URL
VITE_API_URL=/api

# Example: If backend is on a different server or port
# VITE_API_URL=http://localhost:5432/api
