# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
# Never commit .env files - they contain sensitive data like API keys and passwords
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
backend/.env
frontend/.env

# .env.example files SHOULD be committed (they are templates without secrets)
!.env.example
!**/.env.example
!backend/.env.example
!frontend/.env.example

